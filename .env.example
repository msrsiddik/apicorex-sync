# ApiCoreX Sync Plugin — example environment.
# Copy to .env and fill in real values. Never commit .env.

# ── Required ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. Sync tables live in each tenant's schema.
DATABASE_URL=postgres://user:password@localhost:5432/apicorex?sslmode=disable

# Key presented to Core when this plugin registers. Must match Core's PLUGIN_API_KEY.
PLUGIN_API_KEY=change-me-plugin-key

# Core's HTTP base URL (where this plugin registers).
CORE_URL=http://localhost:8080

# ── Plugin server ──────────────────────────────────────────────────────────
PLUGIN_ADDR=:50052
PLUGIN_BASE_URL=http://localhost:50052

# ── Optional: tenant-wide collections ──────────────────────────────────────
# Comma-separated collection names that are shared across all users in a tenant
# (stored with user_id=''). Default: every collection is per-user.
# SYNC_SHARED_COLLECTIONS=org_settings,catalog

# ── Optional: tombstone garbage collection ─────────────────────────────────
# How long deleted records (tombstones) are kept before a daily background
# sweep purges them. A device offline longer than this must do a full re-sync
# (since=0). Go duration syntax. Default: 2160h (90 days).
# SYNC_TOMBSTONE_RETENTION=2160h
